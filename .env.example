# FreeLLMAPI OpenAI-compatible gateway (local development example only)
# For local UX Audit development, set this to your actual FreeLLMAPI API root.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
# FreeLLMAPI route alias configured by the gateway. The default is "auto".
FREELLMAPI_MODEL=auto
FREELLMAPI_MODELS=auto

# Display-only daily budget setting. This is not a usage measurement.
DAILY_BUDGET_INR=100
