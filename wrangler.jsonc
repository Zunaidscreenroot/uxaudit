// Recreate the migration Preview from current Preview Base settings without touching Production.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uxaudit",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "previews": {
    "r2_buckets": [
      {
        "binding": "UX_SHARED_ASSETS",
        "bucket_name": "ux-direct-assets"
      }
    ],
    "vars": {
      "APP_ENV": "preview",
      "DAILY_BUDGET_INR": "100"
    }
  },
  "preview_urls": true,
  "r2_buckets": [
    {
      "binding": "UX_SHARED_ASSETS",
      "bucket_name": "ux-direct-assets"
    }
  ]
}
